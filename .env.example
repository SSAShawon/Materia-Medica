# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New Supabase projects issue a publishable key (sb_publishable_...).
# Older projects use an anon JWT. Either name works; the app checks
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY first, then NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only: used by scripts/seed-medicines.mjs. Never prefix with
# NEXT_PUBLIC_ and never expose it to client components.
SUPABASE_SECRET_KEY=your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key
